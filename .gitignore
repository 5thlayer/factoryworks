config/sodium-options.json
config/runelic.json

# Profiler output, regenerated per run
config/spark/
config/observable.json
observable_announce

# Per-save state, keyed by world/player UUID
gtceu/prospection_cache/
config/chunky/tasks/
config/emi.css

# Python bytecode from the test harness
__pycache__/

# Leftovers from the Core mod's build in a checkout that predates ADR-0128.
.gradle/
build/
mod/

*.log


# Agent worktrees. Each is a second checkout of this repo, not pack content, and a
# `git add -A` from the repo root would otherwise commit every session's copy of it.
.claude/worktrees/
.rtk/
debug-profile.json

mise.local.toml
.probe
kubejs/config/probe-settings.json
