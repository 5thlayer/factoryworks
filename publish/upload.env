# Where scripts/upload.py's tokens live in 1Password. These are references, not secrets:
#   scripts/upload.py runs itself through op run --env-file=publish/upload.env when a token is missing.
# The tokens are the account's, not a project's, so Core shares Beltworks' items with every Library.
MODRINTH_TOKEN=op://Private/Beltworks Modrinth/credential
CURSEFORGE_TOKEN=op://Private/Beltworks CurseForge/credential
